# Quantum-Arb-SOL — environment template. Copy to .env (gitignored).
# SIMULATION / BACKTESTING / PAPER-TRADING ONLY. No keys that can sign or send
# transactions belong in this file. There is no signer in this codebase.

# ---- RPC / DEX endpoints (public) ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6
ORCA_API_URL=https://api.mainnet.orca.so
RAYDIUM_API_URL=https://api-v3.raydium.io

# ---- CEX public endpoints (no auth, public market data only) ----
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
COINBASE_REST_URL=https://api.exchange.coinbase.com
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# ---- Engine ----
ENGINE_WS_PORT=8787            # local WS server the UI/CLI subscribe to
TICK_INTERVAL_MS=200           # base scheduler tick
QUOTE_STALE_MS=2000            # mark quotes older than this as stale
FETCH_TIMEOUT_MS=1500          # per-fetch timeout (< tick when possible)
ENABLE_OBJECT_POOL=true

# ---- Universe ----
# Static top-10 Solana universe is hardcoded in src/models/universe.ts.
# Override the pair list here as comma-separated BASE/QUOTE keys. Empty = use default.
UNIVERSE_OVERRIDE=
# Comma-separated active venues. Pairs absent from ANY of these are dropped.
ACTIVE_VENUES=jupiter,orca,raydium,binance,coinbase

# ---- Risk (paper) ----
RISK_MAX_NOTIONAL_USD=10000
RISK_MIN_EDGE_BPS=5
RISK_INVENTORY_CAP_USD=50000
RISK_MAX_CONCURRENT=4

# ---- Backtester ----
BACKTEST_DATA_DIR=./data
