{
  "name": "quantum-arb-sol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solana DEX/CEX arbitrage research engine — simulation, backtesting and paper-trading only. No real execution.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:engine": "node --import tsx src/ui/cli.ts --live",
    "dev:ui": "vite",
    "bench": "node --import tsx src/ui/cli.ts --bench",
    "backtest": "node --import tsx src/ui/cli.ts --backtest",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^6.19.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
